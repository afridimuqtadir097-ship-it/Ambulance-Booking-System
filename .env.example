# Copy this file to .env and fill in real values before deploying to production.
# (Requires `pip install python-dotenv` and `from dotenv import load_dotenv` in app.py
#  if you want .env to be loaded automatically — otherwise export these in your shell
#  or your hosting platform's environment settings.)

# A long, random, secret string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret

# Leave unset to use the local SQLite database (ambulance.db).
# Example for Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Set to 1 only for local development. Must be 0 (or unset) in production.
FLASK_DEBUG=0

# Port the app listens on (used by app.py / most hosts set this automatically)
PORT=5000

# Credentials for the auto-seeded admin account. The fallback password
# ("admin123") is fine for local development but must be overridden with
# something private before this app is reachable on the public internet --
# seed_database() logs a warning on startup if you're still using it.
ADMIN_EMAIL=admin@ambulanceapp.com
ADMIN_PASSWORD=admin123

# Set to 0 to skip auto-creating the demo drivers + demo patient account on
# startup (the admin account is always seeded regardless, so there's always
# a way in).
SEED_DEMO_DATA=1

# Flask-Limiter's storage backend for login/registration rate limiting.
# In-memory is fine for a single-process deployment (e.g. Render's free
# tier). Only change this if you run multiple worker processes/instances
# and need rate limits enforced globally rather than per-process, e.g.:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://
